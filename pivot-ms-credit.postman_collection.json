  "item": [
    {
      "name": "1. Grant Personal Loan (POST /credits - 201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"personalLoanId\", jsonData.id);",
              "    pm.collectionVariables.set(\"personalLoanNumber\", jsonData.creditNumber);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"creditType\": \"PERSONAL_LOAN\",\n  \"currency\": \"PEN\",\n  \"creditLimit\": 5000.00,\n  \"paymentDueDay\": 15\n}"
        },
        "url": {
          "raw": "{{urlMsCredit}}/credits",
          "host": [
            "{{urlMsCredit}}"
          ],
          "path": [
            "credits"
          ]
        }
      }
    },
